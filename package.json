{
  "name": "proma",
  "version": "0.1.2",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "marketplace:content:package": "bun marketplace-content/package.ts",
    "marketplace:content:validate": "bun marketplace-content/validate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/adm-zip": "0.5.8",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "adm-zip": "0.5.17",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.201",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.201",
    "@hono/node-server": "1.19.10",
    "@xmldom/xmldom": "0.9.10",
    "axios": "1.18.1",
    "fast-uri": "3.1.2",
    "form-data": "4.0.6",
    "hono": "4.12.30",
    "linkify-it": "5.0.1",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "protobufjs": "7.6.1",
    "rollup": "4.62.2",
    "tar": "7.5.20",
    "tmp": "0.2.7",
    "ws": "8.21.1"
  }
}
